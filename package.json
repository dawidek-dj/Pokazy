{
  "name": "pokazy",
  "productName": "Pokazy",
  "version": "1.0.0",
  "description": "Pokazy zdjęć i filmów z wydarzeń i wyjazdów — telewizor, pilot w telefonie, muzyka",
  "main": "src/main.js",
  "author": "Pokazy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "pokazRepo": "",
  "build": {
    "appId": "pl.pokazy.app",
    "productName": "Pokazy",
    "copyright": "Pokazy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Pokazy-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pokazy",
      "artifactName": "Pokazy-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}